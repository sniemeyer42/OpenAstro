<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="$svgWidth" height="$svgHeight"
 viewBox="$viewbox" preserveAspectRatio="xMidYMid">
<title>Esoteric OpenAstro</title>

<g transform="translate($cfgTranslate)" style="font-family:'Liberation Serif'">
<g transform="rotate($cfgRotate)">
<g transform="scale($cfgZoom)">
<rect x="0" y="0" width="772.2" height="546.0" style="fill: $paper_color_1;" />
<text x="20" y="30" style="fill: $paper_color_0; font-size: 24px">$stringTitle</text>
<text x="20" y="50" style="fill: $paper_color_0; font-size: 12px">$stringName</text>
<text x="20" y="62" style="fill: $paper_color_0; font-size: 10px">$stringLocation</text>
<text x="20" y="74" style="fill: $paper_color_0; font-size: 10px">$stringDateTime</text>
<text x="20" y="86" style="fill: $paper_color_0; font-size: 10px">$stringLat</text>
<text x="20" y="98" style="fill: $paper_color_0; font-size: 10px">$stringLon</text>
<text x="20" y="110" style="fill: $paper_color_0; font-size: 10px">$stringPosition</text>
<text x="20" y="480" style="fill: $paper_color_0; font-size: 10px">$bottomLeft1</text>
<text x="20" y="494" style="fill: $paper_color_0; font-size: 10px">$bottomLeft2</text>
<text x="20" y="508" style="fill: $paper_color_0; font-size: 10px">$bottomLeft3</text>
<text x="20" y="522" style="fill: $paper_color_0; font-size: 10px">$bottomLeft4</text>

<!-- Lunar Phase -->
<g transform="translate(20,518)">
<g transform="rotate($lunar_phase_rotate 20 10)">
	<defs>
		<clipPath id="cut-off-circle">
			<circle cx="20" cy="10" r="10"/>
		</clipPath>
	</defs>
	<circle cx="20" cy="10" r="10" style="fill: $lunar_phase_bg;"/>
	<circle cx="$lunar_phase_cx" cy="10" r="$lunar_phase_r" style="fill: $lunar_phase_fg" clip-path="url(#cut-off-circle)" />
	<circle cx="20" cy="10" r="10" style="fill: none; stroke: $lunar_phase_outline; stroke-width: 0.5px; stroke-opacity: .5;"/>
</g>
</g>

<!-- Planets (24x24) -->

<!--#symbols#-->

<g transform="translate(50,50)">
	<g transform="translate($circleX,$circleY)">
	<!-- Zodiac -->
	$makeZodiac
	
	<!-- First Circle -->
	<circle $c1 style="$c1style"/>	

	<!-- Second Circle -->
	<circle $c2 style="$c2style"/>	
	
	<!-- Third Circle -->
	<circle $c3 style="$c3style"/>	
	
	<!-- TransitRing -->
	$transitRing

	<!-- Degree Ring -->
	$degreeRing

	<!-- Houses -->
	$makeHouses
	
	<!-- Planets -->
	$makePlanets
	
	<!-- Aspects -->
	$makeAspects
	</g>
	
	<!-- makePatterns -->
	$makePatterns 	
	
	<!-- AspectGrid -->
	$makeAspectGrid
	
	<!-- Elements -->
	$makeElements

	<!-- Legend -->
	$makeLegend

	<!-- Planet Grid -->
	$makePlanetGrid
	
	<!-- Houses Grid -->
	$makeHousesGrid	

</g>
<!-- testing printer
<rect x="0" y="0" width="772.2" height="546.0" style="fill: $paper_color_1; stroke-width: 1px; stroke:red;" />
<line x1="0" y1="0" x2="772.2" y2="546.0" style="fill:none; stroke-width: 1px; stroke:red;" />
<line x1="772.2" y1="0" x2="0" y2="546.0" style="fill:none; stroke-width: 1px; stroke:red;" />
-->
</g>
</g>
</g>
<!-- testing printer
<rect x="0" y="0" width="$svgWidth" height="$svgHeight" style="fill:none; stroke-width: 1px; stroke:blue;" />
<line x1="0" y1="0" x2="$svgWidth" y2="$svgHeight" style="fill:none; stroke-width: 1px; stroke:blue;" />
<line x1="$svgWidth" y1="0" x2="0" y2="$svgHeight" style="fill:none; stroke-width: 1px; stroke:blue;" />
-->
</svg>
