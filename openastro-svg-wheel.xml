<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="$svgWidth" height="$svgHeight"
 viewBox="$viewbox" preserveAspectRatio="xMidYMid">
<title>OpenAstro chart</title>
<!-- chart wheel alone, the symbols are inserted by the program -->
<!--#symbols#-->
<g style="font-family:'Liberation Serif'">
	<!-- paper behind the wheel -->
	<circle cx="$wheelCenter" cy="$wheelCenter" r="$wheelRadius" style="fill: $paper_color_1;"/>

	<!-- Zodiac -->
	$makeZodiac

	<!-- First Circle -->
	<circle $c1 style="$c1style"/>

	<!-- Second Circle -->
	<circle $c2 style="$c2style"/>

	<!-- Third Circle -->
	<circle $c3 style="$c3style"/>

	<!-- TransitRing -->
	$transitRing

	<!-- Degree Ring -->
	$degreeRing

	<!-- Houses -->
	$makeHouses

	<!-- Planets -->
	$makePlanets

	<!-- Aspects -->
	$makeAspects
</g>
</svg>
